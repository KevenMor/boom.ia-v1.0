# ============================================================
# Boom IA - Docker Compose
# ============================================================
#
# Uso:
#   1. Copie este arquivo para .env e preencha os valores.
#   2. docker-compose up --build -d
#   3. Acesse: http://localhost (proxy une frontend + API em /api)
#
# O proxy expõe apenas a porta 80:
#   - http://localhost/      -> frontend (React)
#   - http://localhost/api/  -> servidor (Node.js)
#
# ============================================================

# ---------- SERVIDOR (API Node.js) ----------
PORT=3001
NODE_ENV=production

# Supabase: use a URL do SEU projeto (não use a do Lovable se você migrou).
# Cloud: https://SEU_PROJECT_REF.supabase.co
# Easypanel (interno): http://NOME_SERVIÇO_SUPABASE:8000
NEXUS_DB_URL=https://SEU_PROJECT_REF.supabase.co
NEXUS_SERVICE_ROLE_KEY=sua_service_role_key_aqui
NEXUS_DB_ANON_KEY=sua_anon_key_aqui

ENCRYPTION_KEY=use-uma-chave-de-32-chars-ou-mais

# Para rodar local com Docker: origem do frontend é http://localhost
API_BASE_URL=http://localhost
CORS_ORIGINS=http://localhost,http://127.0.0.1

# ---------- FRONTEND (Build Args - Vite) ----------
# Use o MESMO projeto Supabase do servidor (NEXUS_*).
# Não use a URL do Lovable Cloud (qqueviooottrostbxkek...) se você já tem
# seu próprio Supabase (Easypanel ou supabase.com).
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua_anon_key_aqui
VITE_SUPABASE_PROJECT_ID=SEU_PROJECT_REF

# No Docker local o proxy expõe a API em /api na mesma origem.
# Para produção (Easypanel): use VITE_API_URL=https://ia.agboom.com.br/api
# e faça o build no Easypanel com esses Build Args.
VITE_API_URL=http://localhost/api
