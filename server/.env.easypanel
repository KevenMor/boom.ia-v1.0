# ============================================================
# Variáveis de Ambiente - SERVIDOR (Easypanel)
# ============================================================
#
# Domínio do sistema: ia.agboom.com.br
#
# Como funciona:
#   - O usuário acessa o painel em: https://ia.agboom.com.br
#   - O frontend (React) chama a API em: https://ia.agboom.com.br/api
#   - No Easypanel você configura o domínio ia.agboom.com.br para o
#     serviço do frontend E um proxy (ou segundo serviço) para /api
#     apontando para o servidor Node.js na porta 3001.
#
# Use APENAS estas variáveis no serviço do SERVIDOR no Easypanel.
# As variáveis VITE_* ficam no build do frontend (Lovable, etc.).
#
# ============================================================

# Porta do servidor (Easypanel geralmente usa 3001 ou a que você configurar)
PORT=3001

# Ambiente de produção
NODE_ENV=production

# ============================================================
# NEXUS DB (Banco de Dados Principal - Supabase)
# ============================================================
#
# NEXUS_DB_URL = URL da API REST do Supabase (NÃO é postgres://)
#
# Se o Supabase está NO EASYPANEL (self-hosted):
#   Use a URL INTERNA entre serviços (Kong usa porta 8000):
#   NEXUS_DB_URL=http://NOME_DO_SERVIÇO_SUPABASE:8000
#   Exemplo: http://boomsolution-supabase:8000
#   (veja o nome exato do serviço Supabase no Easypanel)
#
# Se o Supabase é CLOUD (supabase.com):
#   NEXUS_DB_URL=https://SEU_PROJECT_REF.supabase.co
#
# NEXUS_SERVICE_ROLE_KEY = Chave "service_role" do MESMO projeto
# (Supabase Cloud: Settings > API > service_role)
#
NEXUS_DB_URL=https://boomsolution-supabase.kgn6uc.easypanel.host

# Service Role Key do Supabase (substitua pela chave real do seu projeto)
NEXUS_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# Anon Key do Supabase (fallback)
NEXUS_DB_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE

# ============================================================
# CRIPTOGRAFIA
# ============================================================
# Chave para descriptografar API keys dos providers no banco
# IMPORTANTE: Use uma string de 32+ caracteres aleatórios
# Exemplo: openssl rand -base64 32
ENCRYPTION_KEY=dev-secret-key-32-chars-long!!

# ============================================================
# API BASE URL
# ============================================================
# URL pública do seu servidor (domínio que aponta para o Easypanel)
# Se o painel e a API estão no MESMO domínio (ex: ia.agboom.com.br):
#   - Painel: https://ia.agboom.com.br
#   - API:    https://ia.agboom.com.br/api  → então use:
API_BASE_URL=https://ia.agboom.com.br

# ============================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================
# Domínio de onde o frontend é acessado (onde o usuário abre o painel)
# Deve ser exatamente a origem: https://ia.agboom.com.br (com https, sem barra no final)
# Se tiver mais de um domínio, separe por vírgula
CORS_ORIGINS=https://ia.agboom.com.br

# ============================================================
# LLM API KEYS (Opcional - se não estiverem no banco)
# ============================================================
# Se você configurou os providers no banco com api_key_encrypted,
# NÃO precisa dessas variáveis. Elas servem como fallback.

# OpenAI API Key (dispatcher - GPT-4o-mini)
# OPENAI_API_KEY=sk-proj-...

# Gemini API Key (conversacional - Gemini 2.0 Flash)
# GEMINI_API_KEY=...
# ou
# GOOGLE_GENERATIVE_AI_API_KEY=...

# ============================================================
# LOVABLE CLOUD (Opcional - para fallback de chat)
# ============================================================
# Se você ainda tiver edge functions no Lovable Cloud como backup
# SUPABASE_URL=https://qqueviooottrostbxkek.supabase.co
# SUPABASE_ANON_KEY=eyJhbGci...

# ============================================================
# REDIS (Follow-up BullMQ - opcional)
# ============================================================
# Se configurado, follow-ups usam BullMQ com execução no horário exato (sem cron).
# URL interna do Redis no EasyPanel (ex.: redis://default:SENHA@NOME_SERVIÇO_REDIS:6379)
# Se a senha tiver @, codifique como %40 (ex.: Boom@2025 -> Boom%402025)
# REDIS_URL=redis://default:Boom%402025@conexoesapp_redis_boomia:6379

# ============================================================
# FUNCIONALIDADES EXTRAS (Opcional)
# ============================================================

# Google Maps API Key (para tool nearest_unit / consultar_unidade)
# Quando configurada, usa Distance Matrix API para distância real de carro (em vez de linha reta).
# Veja docs/GOOGLE-MAPS-CONFIG.md para criar a chave e habilitar a API.
# GOOGLE_MAPS_API_KEY=...

# Database URL para migrations (formato PostgreSQL direto)
# DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# Usar chat local (true por padrão, deixe assim)
# USE_CHAT_LOCAL=true

# ============================================================
# NOTAS IMPORTANTES
# ============================================================
# 1. Substitua os valores de exemplo pelos seus valores reais
# 2. NUNCA commite este arquivo com valores reais no Git
# 3. Configure APENAS estas variáveis no serviço do SERVIDOR no Easypanel
#    (no serviço com Build Path = "server", não no frontend)
# 4. Se não conseguir acessar o banco COM SUPABASE NO EASYPANEL:
#    → Troque NEXUS_DB_URL para a URL INTERNA: http://NOME_SERVIÇO_SUPABASE:8000
#    → Exemplo: http://boomsolution-supabase:8000
#    → Veja EASYPANEL-CONFIG.md para o passo a passo
# 5. A ENCRYPTION_KEY deve ser a MESMA usada para criptografar as chaves no banco
# 6. O API_BASE_URL deve ser a URL pública do seu servidor
# 7. O CORS_ORIGINS deve incluir o domínio do seu frontend
# ============================================================
