PORT=3001
NODE_ENV=development

# Nexus DB (banco principal)
NEXUS_DB_URL=https://your-project.supabase.co
# Para migrations: postgresql://postgres:password@host:5432/postgres
DATABASE_URL=
NEXUS_SERVICE_ROLE_KEY=eyJhbGci...
NEXUS_DB_ANON_KEY=eyJhbGci...

# Lovable Cloud (para proxy do chat durante migração)
SUPABASE_URL=https://qqueviooottrostbxkek.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...

# Encryption (para provider-keys)
ENCRYPTION_KEY=your-32-char-secret

# API base URL (para self-calls: queue, webhooks)
API_BASE_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:3001/api
PUBLIC_FRONTEND_URL=http://localhost:8080

# Espelho Chatwoot (Dashboard App — sem login do painel)
# Mesma chave usada na URL: /embed/chatwoot?key=...
CHATWOOT_MIRROR_EMBED_KEY=defina-uma-chave-longa-aqui
# Origens permitidas no iframe (CSV ou * para dev)
# CHATWOOT_EMBED_FRAME_ANCESTORS=https://chat.suaempresa.com

# CORS: origens adicionais em produção (ex: https://app.boomsolution.com)
# CORS_ORIGINS=https://app.boomsolution.com,https://app.boom.com
