# ============================================================
# Boom IA - Variáveis para STACK no Portainer
# ============================================================
#
# Repositório PRIVADO:
#   Preencha GITHUB_USERNAME e GITHUB_TOKEN. No Portainer, ao criar/editar
#   a stack, ative "Repository authentication" e use:
#   - Username = valor de GITHUB_USERNAME
#   - Password = valor de GITHUB_TOKEN
#   (O Portainer não lê o .env para fazer o clone; use esses valores na tela.)
#
# ============================================================

# ---------- GITHUB (repositório privado - copie para Portainer > Repository authentication) ----------
GITHUB_USERNAME=KevenMor
GITHUB_TOKEN=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   

# ---------- SERVIDOR (API Node.js) ----------
PORT=3001
NODE_ENV=production

# Supabase na VPS - URL da API REST (Kong geralmente porta 8000)
# Mesma rede Docker: http://NOME_SERVIÇO_SUPABASE:8000
# Com domínio: https://supabase.sua-vps.com
NEXUS_DB_URL=COLE_AQUI_URL_DO_SUPABASE_VPS
NEXUS_SERVICE_ROLE_KEY=COLE_AQUI_SERVICE_ROLE_KEY
NEXUS_DB_ANON_KEY=COLE_AQUI_ANON_KEY

# Chave para descriptografar API keys no banco (32+ caracteres)
ENCRYPTION_KEY=COLE_AQUI_ENCRYPTION_KEY_32_CHARS

# URL pública do painel (onde o usuário acessa)
# Ex: https://ia.agboom.com.br ou http://IP_DA_VPS
API_BASE_URL=https://ia.agboom.com.br
CORS_ORIGINS=https://ia.agboom.com.br

# Aceitar certificados TLS autoassinados em chamadas internas (ex.: proxy HTTPS)
INTERNAL_API_INSECURE_TLS=true

# Liga/desliga IA por tenant (Dashboard Mega + cron-job.org)
# Mesmo valor do header x-tenant-ai-toggle-secret nos jobs do cron-job.org
TENANT_AI_TOGGLE_SECRET=COLE_AQUI_SECRET_LONGO
# TENANT_AI_TOGGLE_CORS_ORIGINS=https://chat.seu-mega.com
# Opcional — sync: node scripts/cron-tenant-ai/sync-cron-job-org.mjs
# CRONJOB_ORG_API_KEY=COLE_AQUI_API_KEY_DO_CRON_JOB_ORG

# ---------- FRONTEND (Build Args - mesmo Supabase da VPS) ----------
# URL do Supabase que o NAVEGADOR acessa (auth). Se Supabase está na VPS com domínio:
VITE_SUPABASE_URL=COLE_AQUI_URL_PUBLICA_SUPABASE
VITE_SUPABASE_PUBLISHABLE_KEY=COLE_AQUI_ANON_KEY
VITE_SUPABASE_PROJECT_ID=COLE_AQUI_PROJECT_REF

# API do backend: mesmo domínio do painel + /api
VITE_API_URL=https://ia.agboom.com.br/api
