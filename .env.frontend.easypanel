# ============================================================
# Variáveis de Ambiente - FRONTEND (Build Vite)
# ============================================================
#
# Domínio do sistema: ia.agboom.com.br
#
# Configure estas variáveis ONDE VOCÊ FAZ O BUILD do frontend
# (Lovable.dev, Vercel, etc.). O frontend será acessado em
# https://ia.agboom.com.br e vai chamar a API em .../api.
#
# No Easypanel você só coloca as variáveis do SERVIDOR (server/.env.easypanel).
#
# ============================================================

# ============================================================
# SUPABASE (Lovable Cloud)
# ============================================================
# URL do Supabase (Lovable Cloud ou seu Supabase)
VITE_SUPABASE_URL=https://qqueviooottrostbxkek.supabase.co

# Publishable Key (anon key) do Supabase
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFxdWV2aW9vb3R0cm9zdGJ4a2VrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzIxMTU0MTcsImV4cCI6MjA4NzY5MTQxN30.tyit0WSRozRY7C5zlGQAEBjE5zuv0ZtzCNZWM7BxVz0

# Project ID do Supabase
VITE_SUPABASE_PROJECT_ID=qqueviooottrostbxkek

# ============================================================
# API DO SERVIDOR (Backend)
# ============================================================
# URL da API: mesmo domínio do painel + /api
# Se o painel é https://ia.agboom.com.br, a API é:
VITE_API_URL=https://ia.agboom.com.br/api

# ============================================================
# NOTAS IMPORTANTES
# ============================================================
# 1. Essas variáveis são usadas no BUILD do frontend (Vite)
# 2. Configure no Lovable.dev ou no seu CI/CD de build
# 3. O VITE_API_URL deve apontar para o servidor no Easypanel
# 4. Todas as variáveis VITE_* são expostas no bundle do frontend
#    (não coloque segredos aqui, apenas chaves públicas)
# 5. Após alterar, faça rebuild do frontend: npm run build
# ============================================================
